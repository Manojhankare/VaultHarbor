# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL — app runtime (transaction pooler / port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/vaultsync?sslmode=require

# PostgreSQL — migrations & tests (direct or session pooler / port 5432)
DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/vaultsync?sslmode=require
# IPv4-only fallback (session pooler, same database):
# DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/vaultsync?sslmode=require

DB_POOL_MODE=auto

# JWT
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000
REFRESH_ROTATION_GRACE_SECONDS=60

# CORS (comma-separated exact origins; regexes in CORS_ALLOWED_ORIGIN_REGEXES)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_REGEXES=^chrome-extension://.*$,^moz-extension://.*$

# Rate limiting
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per minute

# Security
TRUSTED_PROXY_COUNT=1
FORCE_HTTPS=false
ENABLE_API_DOCS=true

# Payload limits
MAX_CONTENT_LENGTH=4194304
MAX_VAULT_BYTES=2097152

# Account lockout
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# Argon2id (server-side account password hashing)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Logging
LOG_LEVEL=INFO

# Email (password reset)
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=brevo
# EMAIL_API_KEY=your-brevo-api-key
EMAIL_FROM_ADDRESS=noreply@manojhankare.in
EMAIL_FROM_NAME=VaultHarbor
EMAIL_TIMEOUT_SECONDS=5

# Password reset
PASSWORD_RESET_CODE_TTL_SECONDS=900
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MIN_RESPONSE_MS=700
