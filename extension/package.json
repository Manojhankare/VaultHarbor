{
  "name": "vaultsync-extension",
  "version": "0.1.0",
  "author": "Manoj Hankare <manojhankare2@gmail.com> (https://manojhankare.in)",
  "homepage": "https://manojhankare.in",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manojhankare/VaultSync.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run build:chrome",
    "build:chrome": "node scripts/generate-icons.mjs && vite build --mode production && node scripts/copy-manifest.mjs chrome",
    "build:firefox": "vite build --mode production && node scripts/copy-manifest.mjs firefox",
    "package:chrome": "node scripts/package-release.mjs",
    "release:chrome": "npm run build:chrome && npm run package:chrome",
    "version:bump": "node scripts/bump-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
