{
  "manifest_version": 3,
  "name": "VaultSync",
  "version": "0.1.0",
  "description": "Secure zero-knowledge password manager by Manoj Hankare (manojhankare.in)",
  "author": "Manoj Hankare",
  "homepage_url": "https://manojhankare.in",
  "browser_specific_settings": {
    "gecko": {
      "id": "vaultsync@extension.local",
      "strict_min_version": "127.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VaultSync"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "storage",
    "alarms",
    "clipboardWrite",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://vaultsync.manojhankare.in/*",
    "http://localhost:5000/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://vaultsync.manojhankare.in/*",
        "http://localhost:5000/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["picker.html", "save-prompt.html"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
